#!/bin/sh
# Pre-Commit Security Hook - Deskflow Frontend
# Blocks sensitive files and scans content for secrets.

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'

echo ""
printf "%b\n" "${CYAN}============================================${NC}"
printf "%b\n" "${CYAN}PRE-COMMIT SECURITY SCAN${NC}"
printf "%b\n" "${CYAN}============================================${NC}"
echo ""

PATTERNS_FILE="scripts/security/sensitive-patterns.txt"
if [ ! -f "$PATTERNS_FILE" ]; then
    printf "%b\n" "${RED}[ERROR] Patterns file not found: $PATTERNS_FILE${NC}"
    exit 1
fi

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    printf "%b\n" "${YELLOW}[WARN] No files staged for commit${NC}"
    exit 0
fi

printf "%b\n" "${CYAN}[1/2] Scanning staged file names...${NC}"

# ----------------------------------------------------------------
# STEP 1: Check sensitive file names
# ----------------------------------------------------------------
VIOLATIONS=""

for file in $STAGED_FILES; do
    filename=$(basename "$file")

    while IFS= read -r pattern; do
        case "$pattern" in
            ''|\#*) continue ;;
        esac

        matched=0

        if [ "$filename" = "$pattern" ]; then matched=1; fi
        if [ "$file" = "$pattern" ]; then matched=1; fi

        case "$pattern" in
            *\*)
                prefix="${pattern%%\**}"
                suffix="${pattern##*\*}"
                if [ -n "$prefix" ] && [ -z "$suffix" ]; then
                    case "$filename" in ${prefix}*) matched=1 ;; esac
                elif [ -z "$prefix" ] && [ -n "$suffix" ]; then
                    case "$filename" in *${suffix}) matched=1 ;; esac
                fi
                ;;
        esac

        if [ "$matched" = "1" ]; then
            VIOLATIONS="${VIOLATIONS}  ${file}  (matches: ${pattern})\n"
            break
        fi

    done < "$PATTERNS_FILE"
done

if [ -n "$VIOLATIONS" ]; then
    echo ""
    printf "%b\n" "${RED}[SECURITY CHECK FAILED]${NC}"
    printf "%b\n" "${RED}Sensitive files detected in staged changes:${NC}"
    echo ""
    printf "%b" "${YELLOW}${VIOLATIONS}${NC}"
    echo ""
    printf "%b\n" "${CYAN}To fix:${NC}"
    echo "  1. Unstage: git restore --staged <file_name>"
    echo "  2. Add to ignore:  echo '<file_name>' >> .gitignore"
    echo "  3. Use .env.local for secrets, never commit them"
    echo ""
    exit 1
fi

printf "%b\n" "${GREEN}[OK] No sensitive file names detected${NC}"

# ----------------------------------------------------------------
# STEP 2: Scan file content for secrets
# ----------------------------------------------------------------
printf "%b\n" "${CYAN}[2/2] Scanning staged file content for secrets...${NC}"

SECRET_VIOLATIONS=""

for file in $STAGED_FILES; do
    # Skip binary/lock files
    case "$file" in
        *.png|*.jpg|*.jpeg|*.gif|*.ico|*.svg|*.woff|*.woff2|*.ttf|*.eot|*.otf) continue ;;
        *.zip|*.tar|*.gz|*.rar|*.7z|*.pdf|*.lock|package-lock.json|yarn.lock|pnpm-lock.yaml) continue ;;
    esac

    content=$(git show ":$file" 2>/dev/null)
    if [ -z "$content" ]; then continue; fi

    # --- AWS ---
    if echo "$content" | grep -qE 'AKIA[0-9A-Z]{16}'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: AWS Access Key detected\n"; continue
    fi
    if echo "$content" | grep -qiE 'aws_secret_access_key\s*[=:]\s*[A-Za-z0-9/+=]{40}'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: AWS Secret Key detected\n"; continue
    fi

    # --- Private Keys & Certificates ---
    if echo "$content" | grep -qE '\-\-\-\-\-BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY\-\-\-\-\-'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: Private key detected\n"; continue
    fi

    # --- GitHub ---
    if echo "$content" | grep -qE 'ghp_[A-Za-z0-9]{36}|ghs_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{82}'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: GitHub token detected\n"; continue
    fi

    # --- OpenAI ---
    if echo "$content" | grep -qE 'sk-[A-Za-z0-9]{48}|sk-proj-[A-Za-z0-9_-]{50,}'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: OpenAI API key detected\n"; continue
    fi

    # --- Groq ---
    if echo "$content" | grep -qE 'gsk_[A-Za-z0-9]{50,}'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: Groq API key detected\n"; continue
    fi

    # --- Anthropic (Claude) ---
    if echo "$content" | grep -qE 'sk-ant-[A-Za-z0-9_-]{90,}'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: Anthropic API key detected\n"; continue
    fi

    # --- Google / Gemini ---
    if echo "$content" | grep -qE 'AIza[A-Za-z0-9_-]{35}'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: Google API key detected\n"; continue
    fi

    # --- Stripe ---
    if echo "$content" | grep -qE 'sk_live_[A-Za-z0-9]{24,}|pk_live_[A-Za-z0-9]{24,}'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: Stripe live key detected\n"; continue
    fi

    # --- Slack ---
    if echo "$content" | grep -qE 'xox[baprs]-[A-Za-z0-9-]{10,}'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: Slack token detected\n"; continue
    fi

    # --- Twilio ---
    if echo "$content" | grep -qE 'SK[A-Za-z0-9]{32}|AC[a-zA-Z0-9]{32}'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: Twilio credential detected\n"; continue
    fi

    # --- SendGrid ---
    if echo "$content" | grep -qE 'SG\.[A-Za-z0-9_-]{22}\.[A-Za-z0-9_-]{43}'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: SendGrid API key detected\n"; continue
    fi

    # --- Firebase ---
    if echo "$content" | grep -qiE 'firebase.*[A-Za-z0-9_-]{40}|AAAA[A-Za-z0-9_-]{7}:[A-Za-z0-9_-]{140}'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: Firebase credential detected\n"; continue
    fi

    # --- Generic API key assignments (any file) ---
    if echo "$content" | grep -qiE '(api_key|apikey|api_secret|app_secret|access_key|secret_key)\s*[=:]\s*[A-Za-z0-9_\-]{32,}'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: API key assignment detected\n"; continue
    fi

    # --- Hardcoded passwords ---
    if echo "$content" | grep -qiE '(password|passwd|pwd)\s*=\s*"[^"]{8,}"'; then
        if ! echo "$content" | grep -qiE '(password|passwd|pwd)\s*=\s*"(your[-_]?password|change[-_]?me|placeholder|example|xxxx|process\.env)'; then
            SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: Hardcoded password detected\n"; continue
        fi
    fi

    # --- JWT secret ---
    if echo "$content" | grep -qiE '(jwt_secret|jwt_key|jwtSecret)\s*[=:]\s*"[A-Za-z0-9_\-]{16,}"'; then
        SECRET_VIOLATIONS="${SECRET_VIOLATIONS}  ${file}: JWT secret detected\n"; continue
    fi

done

if [ -n "$SECRET_VIOLATIONS" ]; then
    echo ""
    printf "%b\n" "${RED}[SECURITY CHECK FAILED]${NC}"
    printf "%b\n" "${RED}Potential secrets detected in staged file content:${NC}"
    echo ""
    printf "%b" "${YELLOW}${SECRET_VIOLATIONS}${NC}"
    echo ""
    printf "%b\n" "${CYAN}Secret values are NOT printed to protect your credentials.${NC}"
    printf "%b\n" "${CYAN}To fix:${NC}"
    echo "  1. Remove the secret from the file"
    echo "  2. Move it to .env.local and reference via process.env"
    echo "  3. Unstage the file: git restore --staged <file_name>"
    echo ""
    exit 1
fi

printf "%b\n" "${GREEN}[OK] No secrets detected in file content${NC}"
echo ""
printf "%b\n" "${GREEN}[OK] Security scan passed. Safe to Push.${NC}"
echo ""

exit 0
