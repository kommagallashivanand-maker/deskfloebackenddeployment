# Application name used by FastAPI
APP_NAME=priority_feature_extractor

# YAKE keyword extraction configuration
YAKE_TOP=6
YAKE_NGRAM_MAX=2

# Sentiment score thresholds
SENTIMENT_NEGATIVE_THRESH=-0.1
SENTIMENT_POSITIVE_THRESH=0.25

# Path to local category mapping JSON file
CATEGORY_MAPPING_PATH=sample_data/category_mapping.json

# Feature flag to enable or disable category mapping lookup
USE_CATEGORY_MAPPING=False
