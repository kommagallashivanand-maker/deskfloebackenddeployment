# ------------------------------------------------------------------
# DeskFlow Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to Git.
# ------------------------------------------------------------------

# ---------------------
# Database (PostgreSQL)
# ---------------------
DB_USERNAME=
DB_PASSWORD=

# ---------------------
# Spring Boot Backend
# ---------------------
JWT_SECRET=
JWT_EXPIRATION_MS=
# ---------------------
# AWS S3 (for attachments)
# Leave empty to use defaults / local mock
# ---------------------
AWS_S3_BUCKET=deskflow-attachments
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------
# Logging
# Options: DEBUG, INFO, WARNING, ERROR
# ---------------------
LOG_LEVEL=INFO
