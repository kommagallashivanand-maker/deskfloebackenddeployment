# ------------------------------------------------------------------
# Environment Variable Guidelines
#
# - Add only environment variable names and optional descriptions.
# - Do NOT add actual values, secrets, passwords, API keys, or tokens.
# - Developers should copy these variables to their local `.env.local`
#   file and provide environment-specific values there.
# - If a new environment variable is required, add its name and purpose
#   to this file so other developers know it is needed.
# - Never commit `.env.local`, `.env.staging`, or `.env.production`
#   files to Git.
# ------------------------------------------------------------------

# Database hostname
DB_HOST=

# Database port
DB_PORT=

# Database username
DB_USER=

# Database password
DB_PASSWORD=

# JWT signing secret
JWT_SECRET=

# Backend API URL
API_URL=